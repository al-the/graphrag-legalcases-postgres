{
  "buildCommand": "cd src/frontend && npm ci && npm run build",
  "outputDirectory": "src/backend/static",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/(.*)",       "destination": "/index.html" }
  ]
}
